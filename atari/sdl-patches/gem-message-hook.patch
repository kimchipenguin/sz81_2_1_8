+/* Local addition (not upstream): the application sees every message first,
+   so it can handle menu selections and its own windows. A non-zero return
+   means the message was handled and the driver ignores it */
+
+static int (*GEM_message_hook)(const short *message);
+
+void SDL_AtariGem_SetMessageHook(int (*hook)(const short *message))
+{
+	GEM_message_hook = hook;
+}
+
 static int do_messages(_THIS, short *message, short latest_msg_id)
 {
 	int quit, update_work_area, sdl_resize;
 
 	quit = update_work_area = sdl_resize = 0;
+	if (GEM_message_hook && GEM_message_hook(message)) {
+		return 0;
+	}
 	switch (message[0]) {
 		case MSG_SDL_ID:
 			quit=(message[1] == latest_msg_id);
